  "entry": {
    "id": "e02:mathlib:one_div_lt_one_div_of_lt",
    "name": "one_div_lt_one_div_of_lt",
    "module": "Mathlib.Algebra.Order.Field.Basic",
    "fullType": "∀ {α : Type u} [Semifield α] [PartialOrder α] [PosMulReflectLT α] {a b : α}, 0 < a → a < b → 1 / b < 1 / a",
    "realType": "∀ {x y : ℝ}, 0 < x → x < y → 1 / y < 1 / x",
    "premises": [
      "α : Type u",
      "[Semifield α]",
      "[PartialOrder α]",
      "[PosMulReflectLT α]",
      "{a b : α}",
      "ha : 0 < a",
      "h : a < b"
    ],
    "source": {
