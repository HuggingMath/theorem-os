  "branches": [
    {
      "id": "positive",
      "label": "严格正前提 · b > 0",
      "assumptions": [
        "a b : ℝ",
        "ha : 0 < a",
        "hb : 0 < b"
      ],
      "theoremName": "TheoremOSE02.reciprocal_strict",
      "file": "lean/Success.lean",
      "sourceSha256": "b7c0755f477e8f829130279328eaa1e5235b24d4444b70638ffedd97288d0844",
      "expectedType": "∀ (a b : ℝ), 0 < a → 0 < b → 1 / (a + b) < 1 / a",
      "expression": "fun (a b : ℝ) (ha : 0 < a) (hb : 0 < b) => one_div_lt_one_div_of_lt ha (lt_add_of_pos_right a hb)",
      "arguments": [
        {
          "parameter": "α",
          "value": "ℝ"
        },
        {
          "parameter": "a (entry)",
          "value": "a (target)"
        },
        {
          "parameter": "b (entry)",
          "value": "a + b (target)"
        },
        {
          "parameter": "ha",
          "value": "ha"
        },
        {
          "parameter": "h",
          "value": "lt_add_of_pos_right a hb"
        }
      ],
      "adaptationSteps": [
        "将条目中的两参数实例化为 x = a、y = a + b。",
        "使用局部假设 ha : 0 < a。",
        "由 hb 的严格正性构造 a < a + b，再调用固定倒数条目。"
      ],
      "obligations": [
        {
          "id": "positive-denominator",
          "statement": "0 < a",
          "status": "closed",
          "reason": "局部假设 ha。"
        },
        {
          "id": "strict-increase",
          "statement": "a < a + b",
          "status": "closed",
          "reason": "由 hb : 0 < b，lt_add_of_pos_right a hb 通过。"
        }
      ],
      "change": {
        "kind": "hand-authored-case",
        "expressionApplied": "one_div_lt_one_div_of_lt ha (lt_add_of_pos_right a hb)",
        "source": "lean/Success.lean",
        "strictConclusionUnchanged": true
      },
      "targetVersion": "e2bbc5fd70de817e83b22a934c11eb2cdf020efb4832741caf7427808c8070d6"
    },
    {
      "id": "nonnegative",
      "label": "前提不足 · b ≥ 0",
      "assumptions": [
        "a b : ℝ",
        "ha : 0 < a",
        "hb : 0 ≤ b"
      ],
      "theoremName": "TheoremOSE02.reciprocal_strict_nonnegative_attempt",
      "file": "lean/Insufficient.lean",
      "sourceSha256": "ea64eadaa03fad36df5a2d84823edbc2126c070736dd05dd1b6ccaa4c9cc431a",
      "expectedType": "∀ (a b : ℝ), 0 < a → 0 ≤ b → 1 / (a + b) < 1 / a",
      "expression": "fun (a b : ℝ) (ha : 0 < a) (hb : 0 ≤ b) => one_div_lt_one_div_of_lt ha (lt_add_of_pos_right a hb)",
      "arguments": [
        {
          "parameter": "α",
          "value": "ℝ"
        },
        {
          "parameter": "a (entry)",
          "value": "a (target)"
        },
        {
          "parameter": "b (entry)",
          "value": "a + b (target)"
        },
        {
          "parameter": "ha",
          "value": "ha"
        },
        {
          "parameter": "h",
          "value": "lt_add_of_pos_right a hb"
        }
      ],
      "adaptationSteps": [
        "将条目中的两参数实例化为 x = a、y = a + b。",
        "使用局部假设 ha : 0 < a。",
        "尝试由 hb 构造 a < a + b，但 hb 仅给出 0 ≤ b，缺少 0 < b；该适配未闭合。"
      ],
      "obligations": [
        {
          "id": "positive-denominator",
          "statement": "0 < a",
          "status": "closed",
          "reason": "局部假设 ha。"
        },
        {
          "id": "strict-increase",
          "statement": "a < a + b",
          "status": "open",
          "reason": "hb 只有 0 ≤ b，无法提供 lt_add_of_pos_right 所需的 0 < b；b = 0 时严格结论为假。"
        }
      ],
      "change": {
        "kind": "hand-authored-case",
        "expressionApplied": "one_div_lt_one_div_of_lt ha (lt_add_of_pos_right a hb)",
        "source": "lean/Insufficient.lean",
        "strictConclusionUnchanged": true
      },
      "targetVersion": "5c79c58b6fc776e0f845355c5c296994e337dfd79e452cb95093d7fc72bf26a7"
    }
  ],
  "counterexample": {
    "file": "lean/Counterexample.lean",
    "description": "取 a = 1、b = 0，满足 a > 0 与 b ≥ 0，但严格结论变成 1 < 1。另有任意 a 的 b = 0 边界以及弱化全称命题的否定证明。"
  },
