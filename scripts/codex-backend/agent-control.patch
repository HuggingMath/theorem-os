+pub(crate) struct NativeAgentBridge {
+    outgoing: Arc<OutgoingMessageSender>,
+    manager: OnceLock<Weak<ThreadManager>>,
+    bootstraps: Mutex<HashMap<ThreadId, NativeChildBootstrap>>,
+    controls: Mutex<HashMap<ThreadId, NativeHostControl>>,
+    input_locks: tokio::sync::Mutex<HashMap<ThreadId, Arc<tokio::sync::Mutex<()>>>>,
+}
+
+impl NativeAgentBridge {
+    pub(crate) fn new(outgoing: Arc<OutgoingMessageSender>) -> Option<Arc<Self>> {
+        (std::env::var("THEOREMOS_HOST_AGENT_CONTROL")
+            .ok()
+            .as_deref()
+            == Some("1"))
+        .then(|| {
+            Arc::new(Self {
+                outgoing,
+                manager: OnceLock::new(),
+                bootstraps: Mutex::new(HashMap::new()),
+                controls: Mutex::new(HashMap::new()),
+                input_locks: tokio::sync::Mutex::new(HashMap::new()),
+            })
+        })
+    }
+    pub(crate) fn bind_manager(&self, manager: &Arc<ThreadManager>) {
+        let _ = self.manager.set(Arc::downgrade(manager));
+    }
+    fn manager(&self) -> Result<Arc<ThreadManager>> {
+        self.manager.get().and_then(Weak::upgrade).ok_or_else(|| {
+            CodexErr::InvalidRequest("native host thread manager is unavailable".into())
+        })
+    }
+
+    pub(crate) async fn controller(
+        self: Arc<Self>,
+        thread_id: ThreadId,
+    ) -> Result<Arc<dyn AgentControl>> {
+        let bootstrap = self
+            .bootstraps
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .get(&thread_id)
+            .cloned();
+        let session_id = bootstrap
+            .as_ref()
+            .map(|b| b.session_id)
+            .unwrap_or_else(|| thread_id.into());
+        let mut control = NativeHostControl {
+            bridge: Arc::downgrade(&self),
+            thread_id,
+            session_id,
+            local: Arc::new(Mutex::new(LocalState::default())),
+        };
+        self.controls
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .insert(thread_id, control.clone());
+        let response = match control
+            .rpc(
+                "attach",
+                json!({"threadId":thread_id,"sessionId":session_id}),
+            )
+            .await
+        {
+            Ok(response) => response,
+            Err(error) => {
+                self.controls
+                    .lock()
+                    .unwrap_or_else(PoisonError::into_inner)
+                    .remove(&thread_id);
+                return Err(error);
+            }
+        };
+        control.session_id = serde_json::from_value(
+            response
+                .get("sessionId")
+                .cloned()
+                .ok_or_else(|| CodexErr::InvalidRequest("host attach omitted sessionId".into()))?,
+        )
+        .map_err(decode_error)?;
+        self.controls
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .insert(thread_id, control.clone());
+        Ok(Arc::new(control))
+    }
+
+    pub(crate) fn register_bootstrap(
+        &self,
+        bootstrap: NativeChildBootstrap,
+    ) -> std::result::Result<(), JSONRPCErrorError> {
+        let id = bootstrap
+            .thread_id
+            .ok_or_else(|| invalid_params("native child threadId must be reserved"))?;
+        let mut entries = self
+            .bootstraps
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner);
+        if entries.contains_key(&id) {
+            return Err(invalid_request("native child startup is already reserved"));
+        }
+        entries.insert(id, bootstrap);
+        Ok(())
+    }
+
+    pub(crate) async fn input(
+        &self,
+        value: Value,
+    ) -> std::result::Result<Value, JSONRPCErrorError> {
+        #[derive(Deserialize)]
+        #[serde(rename_all = "camelCase", deny_unknown_fields)]
+        struct Input {
+            version: u8,
+            thread_id: ThreadId,
+            author: AgentPath,
+            input: NativeAgentInput,
+            #[serde(default)]
+            start_options: NativeTurnStartOptions,
+            expected_turn_id: Option<String>,
+            #[serde(default)]
+            context_items: Vec<ResponseItem>,
+        }
+        let input: Input =
+            serde_json::from_value(value).map_err(|error| invalid_params(error.to_string()))?;
+        if input.version != 1 {
+            return Err(invalid_params("unsupported native input version"));
+        }
+        let lock = self
+            .input_locks
+            .lock()
+            .await
+            .entry(input.thread_id)
+            .or_default()
+            .clone();
+        let _lock = lock.lock().await;
+        let thread = self
+            .manager()
+            .map_err(rpc_error)?
+            .get_thread(input.thread_id)
+            .await
+            .map_err(rpc_error)?;
+        codex_core::native_submit_agent_input(
+            thread.as_ref(),
+            input.author,
+            input.input,
+            input.start_options,
+            input.context_items,
+            input.expected_turn_id,
+        )
+        .await
+        .map_err(rpc_error)
+    }
+
+    pub(crate) async fn snapshot(
+        &self,
+        value: Value,
+    ) -> std::result::Result<Value, JSONRPCErrorError> {
+        let thread_id: ThreadId = serde_json::from_value(
+            value
+                .get("threadId")
+                .cloned()
+                .ok_or_else(|| invalid_params("threadId is required"))?,
+        )
+        .map_err(|error| invalid_params(error.to_string()))?;
+        let thread = self
+            .manager()
+            .map_err(rpc_error)?
+            .get_thread(thread_id)
+            .await
+            .map_err(rpc_error)?;
+        codex_core::native_agent_snapshot(thread.as_ref())
+            .await
+            .map_err(rpc_error)
+    }
+
+    pub(crate) fn update(&self, value: Value) -> std::result::Result<Value, JSONRPCErrorError> {
+        #[derive(Deserialize)]
+        #[serde(rename_all = "camelCase", deny_unknown_fields)]
+        struct Update {
+            version: u8,
+            session_id: SessionId,
+            thread_id: ThreadId,
+            sequence: u64,
+            #[serde(default)]
+            mailbox: Vec<Mail>,
+            #[serde(default)]
+            service_tier: Option<Option<String>>,
+            admission: Option<Admission>,
+        }
+        #[derive(Deserialize)]
+        struct Mail {
+            id: String,
+            author: AgentPath,
+            recipient: AgentPath,
+            message: Option<Value>,
+            communication: Option<InterAgentCommunication>,
+        }
+        #[derive(Deserialize)]
+        struct Admission {
+            allowed: bool,
+            reason: Option<String>,
+        }
+        let tier_update = value
+            .get("serviceTier")
+            .map(|value| serde_json::from_value::<Option<String>>(value.clone()))
+            .transpose()
+            .map_err(|error| invalid_params(error.to_string()))?;
+        let update: Update =
+            serde_json::from_value(value).map_err(|error| invalid_params(error.to_string()))?;
+        let _ = &update.service_tier;
+        if update.version != 1 {
+            return Err(invalid_params("unsupported native update version"));
+        }
+        let controls = self.controls.lock().unwrap_or_else(PoisonError::into_inner);
+        let control = controls
+            .get(&update.thread_id)
+            .ok_or_else(|| invalid_request("native runtime is not attached"))?;
+        if update.session_id != control.session_id {
+            return Err(invalid_request("native session identity mismatch"));
+        }
+        let mut local = control.local.lock().unwrap_or_else(PoisonError::into_inner);
+        if update.sequence <= local.sequence {
+            return Ok(json!({"acceptedSequence":local.sequence}));
+        }
+        // Decode the complete batch before ownership transfer; malformed mail is never partially accepted.
+        let mut batch = Vec::new();
+        for mail in update.mailbox {
+            if local.mail_ids.contains(&mail.id) {
+                continue;
+            }
+            let communication = if let Some(communication) = mail.communication {
+                if communication.author != mail.author
+                    || communication.recipient != mail.recipient
+                    || communication.trigger_turn
+                {
+                    return Err(invalid_params(
+                        "invalid queue-only native communication attribution",
+                    ));
+                }
+                communication
+            } else {
+                let input:NativeAgentInput=serde_json::from_value(json!({"kind":"message","message":mail.message.ok_or_else(||invalid_params("mail message is required"))?,"mode":"queueOnly"})).map_err(|error|invalid_params(error.to_string()))?;
+                let NativeAgentInput::Message { message, mode } = input else {
+                    unreachable!()
+                };
+                message.into_communication(mail.author, mail.recipient, mode)
+            };
+            batch.push((mail.id, PendingAgentMessage::from(communication)));
+        }
+        for (id, message) in batch {
+            if local.mail_ids.insert(id) {
+                local.mailbox.push(message);
+            }
+        }
+        if let Some(tier) = tier_update {
+            local.service_tier = tier;
+        }
+        if let Some(admission) = update.admission {
+            local.allowed = admission.allowed;
+            local.denial = admission.reason;
+        }
+        local.sequence = update.sequence;
+        local.watch.send_replace(!local.mailbox.is_empty());
+        Ok(json!({"acceptedSequence":local.sequence}))
+    }
+}
+
+struct LocalState {
+    sequence: u64,
+    mailbox: Vec<PendingAgentMessage>,
+    mail_ids: HashSet<String>,
+    watch: watch::Sender<bool>,
+    service_tier: Option<String>,
+    allowed: bool,
+    denial: Option<String>,
+}
+impl Default for LocalState {
+    fn default() -> Self {
+        Self {
+            sequence: 0,
+            mailbox: Vec::new(),
+            mail_ids: HashSet::new(),
+            watch: watch::channel(false).0,
+            service_tier: None,
+            allowed: true,
+            denial: None,
+        }
+    }
+}
