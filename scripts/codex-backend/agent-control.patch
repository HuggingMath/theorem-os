+fn deserialize_host_dynamic_tools<'de, D: serde::Deserializer<'de>>(
+    deserializer: D,
+) -> std::result::Result<Option<Vec<DynamicToolSpec>>, D::Error> {
+    let values = Option::<Vec<Value>>::deserialize(deserializer)?;
+    values
+        .map(codex_protocol::dynamic_tools::normalize_dynamic_tool_specs)
+        .transpose()
+        .map_err(serde::de::Error::custom)
+}
+
+pub fn apply_native_child_resume_bootstrap(
+    options: &mut StartThreadOptions,
+    bootstrap: NativeChildBootstrap,
+) -> Result<()> {
+    validate_native_resume_identity(
+        &options.initial_history,
+        bootstrap.thread_id,
+        bootstrap.session_id,
+        &bootstrap.source,
+    )?;
+    let history = options.initial_history.clone();
+    apply_native_child_bootstrap(options, bootstrap)?;
+    options.initial_history = history;
+    options.reserved_thread_id = None;
+    Ok(())
+}
+
+fn validate_native_resume_identity(
+    initial_history: &InitialHistory,
+    thread_id: Option<ThreadId>,
+    session_id: SessionId,
+    source: &SessionSource,
+) -> Result<()> {
+    let InitialHistory::Resumed(history) = initial_history else {
+        return Err(CodexErr::InvalidRequest(
+            "native resume requires persisted history".into(),
+        ));
+    };
+    if Some(history.conversation_id) != thread_id {
+        return Err(CodexErr::InvalidRequest(
+            "native resume thread identity mismatch".into(),
+        ));
+    }
+    let metadata = history.history.iter().find_map(|item| match item {
+        codex_history::RolloutItem::SessionMeta(line) => Some(&line.meta),
+        _ => None,
+    });
+    if !metadata.is_some_and(|metadata| {
+        metadata.id == history.conversation_id
+            && metadata.session_id == session_id
+            && &metadata.source == source
+    }) {
+        return Err(CodexErr::InvalidRequest(
+            "native resume persisted session or source identity mismatch".into(),
+        ));
+    }
+    Ok(())
+}
+
+pub async fn prepare_native_child_bootstrap(
+    parent: &CodexThread,
+    session_id: SessionId,
+    request: SpawnRequest,
+) -> Result<(NativeChildBootstrap, Value, NativeTurnStartOptions)> {
+    if request.caller != parent.session.thread_id {
+        return Err(CodexErr::InvalidRequest(
+            "spawn caller does not match runtime".into(),
+        ));
+    }
+    let start = NativeTurnStartOptions::from(TurnStartOptions {
+        parent_turn_id: request.options.parent_turn_id.clone(),
+        root_turn_id: request.options.root_turn_id.clone(),
+        turn_trigger: request.options.turn_trigger.clone(),
+        initiating_agent_path: request.source.get_agent_path().and_then(|path| {
+            path.as_str()
+                .rsplit_once('/')
+                .and_then(|(parent, _)| AgentPath::try_from(parent).ok())
+        }),
+        ..Default::default()
+    });
+    let input = native_agent_input_value(request.input);
+    let settings = NativeChildSettings {
+        model: request.config.model.clone(),
+        reasoning_effort: request.config.model_reasoning_effort.clone(),
+        service_tier: request.config.service_tier.clone(),
+        reasoning_summary: request.config.model_reasoning_summary,
+        personality: request.config.personality,
+        base_instructions: request.config.base_instructions.clone(),
+        developer_instructions: request.config.developer_instructions.clone(),
+        approval_policy: request.config.permissions.approval_policy.value(),
+        approvals_reviewer: request.config.approvals_reviewer,
+        permission_profile: request.config.permissions.effective_permission_profile(),
+        network_policy: request
+            .config
+            .permissions
+            .network
+            .as_ref()
+            .map(|network| network.environment_policy()),
+        cwd: request.config.cwd.clone(),
+    };
+    let (options, inheritance, _) = prepare_spawn_inputs(
+        parent,
+        ChildSpawnSettings {
+            config: request.config,
+            source: request.source.clone(),
+            options: request.options,
+        },
+    )
+    .await?;
+    let (exec_policy, requirements) = match inheritance.exec_policy {
+        Some(manager) => manager.snapshot(),
+        None => parent.session.services.exec_policy.snapshot(),
+    };
+    let environments = options
+        .inherited_environments
+        .as_ref()
+        .map(|snapshot| snapshot.inheritable_requests())
+        .unwrap_or_default();
+    Ok((
+        NativeChildBootstrap {
+            version: 1,
+            session_id,
+            thread_id: None,
+            source: request.source,
+            config: settings,
+            initial_history: options.initial_history,
+            history_mode: options.history_mode,
+            user_instructions: inheritance.instructions.user.map(Into::into),
+            thread_instructions: inheritance.instructions.thread.map(Into::into),
+            exec_policy: (*exec_policy).clone(),
+            exec_policy_source_requirements: requirements.as_deref().cloned(),
+            environments,
+            dynamic_tools: options.dynamic_tools,
+            disabled_plugin_ids: options.disabled_plugin_ids,
+            originator: inheritance.originator,
+            host_overrides: NativeHostOverrides::default(),
+        },
+        input,
+        start,
+    ))
+}
+
+pub fn apply_native_child_bootstrap(
+    options: &mut StartThreadOptions,
+    bootstrap: NativeChildBootstrap,
+) -> Result<()> {
+    if bootstrap.version != 1 || !bootstrap.source.is_non_root_agent() {
+        return Err(CodexErr::InvalidRequest(
+            "unsupported native child bootstrap".into(),
+        ));
+    }
+    let child_id = bootstrap.thread_id.ok_or_else(|| {
+        CodexErr::InvalidRequest("native child thread ID must be reserved by host".into())
+    })?;
+    if SessionId::from(child_id) == bootstrap.session_id {
+        return Err(CodexErr::InvalidRequest(
+            "child cannot use root identity".into(),
+        ));
+    }
+    let dest_cwd = bootstrap
+        .host_overrides
+        .cwd
+        .clone()
+        .unwrap_or_else(|| options.config.cwd.clone());
+    if options.config.cwd != dest_cwd {
+        return Err(CodexErr::InvalidRequest(
+            "bootstrap cwd must match destination profile cwd".into(),
+        ));
+    }
+    let mut authority = bootstrap.config.permission_profile.clone();
+    if let Some(relocation) = &bootstrap.host_overrides.workspace_relocation {
+        if relocation.from != bootstrap.config.cwd
+            || relocation.to != dest_cwd
+            || relocation.from == relocation.to
+        {
+            return Err(CodexErr::InvalidRequest(
+                "invalid trusted workspace relocation".into(),
+            ));
+        }
+        authority = relocate_workspace_authority(&authority, &relocation.from, &relocation.to)?;
+    }
+    let destination_network = options
+        .config
+        .permissions
+        .network
+        .as_ref()
+        .map(|network| network.environment_policy());
+    validate_native_network_policy(
+        bootstrap.config.network_policy.as_ref(),
+        destination_network.as_ref(),
+    )?;
+    let destination = options.config.permissions.effective_permission_profile();
+    let mut permissions =
+        intersect_effective_permission_profiles(&authority, &destination, dest_cwd.as_path())
+            .map_err(|error| {
+                CodexErr::InvalidRequest(format!("native child permission intersection: {error}"))
+            })?;
+    if let Some(requested) = &bootstrap.host_overrides.permission_profile {
+        permissions =
+            intersect_effective_permission_profiles(&permissions, requested, dest_cwd.as_path())
+                .map_err(|error| {
+                    CodexErr::InvalidRequest(format!(
+                        "native child host permission restriction: {error}"
+                    ))
+                })?;
+    }
+    options
+        .config
+        .permissions
+        .set_permission_profile(permissions)
+        .map_err(|error| {
+            CodexErr::InvalidRequest(format!(
+                "destination rejected inherited permissions: {error}"
+            ))
+        })?;
+    options
+        .config
+        .permissions
+        .approval_policy
+        .set(bootstrap.config.approval_policy)
+        .map_err(|error| {
+            CodexErr::InvalidRequest(format!("destination rejected approval policy: {error}"))
+        })?;
+    options.config.approvals_reviewer = bootstrap.config.approvals_reviewer;
+    options.config.model = bootstrap.config.model;
+    options.config.model_reasoning_effort = bootstrap.config.reasoning_effort;
+    options.config.service_tier = bootstrap.config.service_tier;
+    options.config.model_reasoning_summary = bootstrap.config.reasoning_summary;
+    options.config.personality = bootstrap.config.personality;
+    options.config.base_instructions = bootstrap.config.base_instructions;
+    options.config.developer_instructions = bootstrap
+        .host_overrides
+        .developer_instructions
+        .or(bootstrap.config.developer_instructions);
+    options.initial_history = bootstrap.initial_history;
+    options.history_mode = bootstrap.history_mode;
+    options.session_source = Some(bootstrap.source);
+    options.thread_source = Some(ThreadSource::Subagent);
+    options.reserved_thread_id = Some(child_id);
+    options.user_instructions = Some(LoadedUserInstructions {
+        instructions: bootstrap.user_instructions.map(Into::into),
+        warnings: Vec::new(),
+    });
+    options.set_inherited_thread_instructions(
+        bootstrap
+            .thread_instructions
+            .map(Into::into)
+            .unwrap_or(Instructions {
+                text: String::new(),
+                source: None,
+            }),
+    );
+    // The captured policy already includes the parent's user/project rules. The isolated
+    // destination must not re-read a different worktree's user/project policy. Managed
+    // requirements and system policy sources remain subject to native compatibility checks.
+    options.config.config_layer_stack = options
+        .config
+        .config_layer_stack
+        .clone()
+        .with_user_and_project_exec_policy_rules_ignored(true);
+    options.set_inherited_exec_policy(
+        Arc::new(bootstrap.exec_policy),
+        bootstrap.exec_policy_source_requirements.map(Arc::new),
+    );
+    options.dynamic_tools = bootstrap
+        .host_overrides
+        .dynamic_tools
+        .unwrap_or(bootstrap.dynamic_tools);
+    options.disabled_plugin_ids = bootstrap.disabled_plugin_ids;
+    if let Some(environments) = bootstrap.host_overrides.environments {
+        options.environments = Some(environments);
+    } else if bootstrap.host_overrides.workspace_relocation.is_none() {
+        options.environments = Some(bootstrap.environments);
+    }
+    // Relocated environments come from the destination's trusted profile, never parent bindings.
+    // Native subagents get the shared session identity from their attached
+    // AgentControl (or persisted metadata on resume). InheritedSessionId is only
+    // valid for fresh host-root threads and must not be installed for this path.
+    options
+        .thread_extension_init
+        .insert(RestrictRootCapabilities);
+    options
+        .thread_extension_init
+        .insert(TransportedAgentOriginator(bootstrap.originator));
+    Ok(())
+}
+
+// Proxy listeners, credentials and URLs belong to the destination. The current
+// transport supports the same captured traffic policy, plus an independently
+// restrictive destination when the parent did not use a proxy. Different proxy
+// allowlists fail closed rather than guessing whether wildcard rules are subsets.
+fn validate_native_network_policy(
+    captured: Option<&EnvironmentNetworkPolicy>,
+    destination: Option<&EnvironmentNetworkPolicy>,
+) -> Result<()> {
+    if let Some(captured) = captured
+        && Some(captured) != destination
+    {
+        return Err(CodexErr::InvalidRequest(
+            "native child destination network policy differs from captured authority".into(),
+        ));
+    }
+    Ok(())
+}
+
+fn relocate_workspace_authority(
+    profile: &PermissionProfile,
+    from: &AbsolutePathBuf,
+    to: &AbsolutePathBuf,
+) -> Result<PermissionProfile> {
+    let (mut filesystem, network) = profile.to_runtime_permissions();
+    let mut saw_workspace_grant = false;
+    filesystem.entries.retain(|entry| {
+        let FileSystemPath::Path { path } = &entry.path else {
+            return true;
+        };
+        let Ok(path) = path.to_abs_path() else {
+            return true;
+        };
+        if entry.access == FileSystemAccessMode::Write && path.as_path().starts_with(from.as_path())
+        {
+            saw_workspace_grant = true;
+            return false;
+        }
+        // The trusted host rebinds this subtree in an independent namespace. Other denies survive.
+        !(entry.access == FileSystemAccessMode::Deny && to.as_path().starts_with(path.as_path()))
+    });
+    if !saw_workspace_grant {
+        return Err(CodexErr::InvalidRequest(
+            "relocation requires captured workspace write authority".into(),
+        ));
+    }
+    filesystem
+        .entries
+        .push(codex_protocol::permissions::FileSystemSandboxEntry::new(
+            FileSystemPath::Path {
+                path: codex_utils_path_uri::PathUri::from_abs_path(to),
+            },
+            FileSystemAccessMode::Write,
+        ));
+    Ok(
+        PermissionProfile::from_runtime_permissions_with_enforcement(
+            profile.enforcement(),
+            &filesystem,
+            network,
+        ),
+    )
+}
