+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "camelCase")]
+pub enum NativeAgentInput {
+    Message {
+        message: NativeMessage,
+        mode: NativeDeliveryMode,
+    },
+    UserInput {
+        items: Vec<UserInput>,
+    },
+    Communication {
+        communication: InterAgentCommunication,
+    },
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(tag = "kind", content = "text", rename_all = "camelCase")]
+pub enum NativeMessage {
+    Plaintext(String),
+    Encrypted(String),
+}
+#[derive(Clone, Copy, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub enum NativeDeliveryMode {
+    QueueOnly,
+    TriggerTurn,
+}
+impl NativeMessage {
+    pub fn into_communication(
+        self,
+        author: AgentPath,
+        recipient: AgentPath,
+        mode: NativeDeliveryMode,
+    ) -> InterAgentCommunication {
+        let message = match self {
+            Self::Plaintext(text) => AgentMessage::Plaintext(text),
+            Self::Encrypted(text) => AgentMessage::Encrypted(text),
+        };
+        message.into_communication(
+            author,
+            recipient,
+            match mode {
+                NativeDeliveryMode::QueueOnly => MessageDeliveryMode::QueueOnly,
+                NativeDeliveryMode::TriggerTurn => MessageDeliveryMode::TriggerTurn,
+            },
+        )
+    }
+}
+pub fn native_agent_input_value(input: AgentInput) -> Value {
+    let input = match input {
+        AgentInput::UserInput(items) => NativeAgentInput::UserInput { items },
+        AgentInput::Message { message, mode } => NativeAgentInput::Message {
+            message: match message {
+                AgentMessage::Plaintext(text) => NativeMessage::Plaintext(text),
+                AgentMessage::Encrypted(text) => NativeMessage::Encrypted(text),
+            },
+            mode: match mode {
+                MessageDeliveryMode::QueueOnly => NativeDeliveryMode::QueueOnly,
+                MessageDeliveryMode::TriggerTurn => NativeDeliveryMode::TriggerTurn,
+            },
+        },
+    };
+    serde_json::to_value(input).expect("native agent input is serializable")
+}
+
+pub fn native_completion_communication(
+    outcome: &AgentTurnOutcome,
+) -> Option<(ThreadId, InterAgentCommunication)> {
+    let codex_protocol::protocol::SessionSource::SubAgent(
+        codex_protocol::protocol::SubAgentSource::ThreadSpawn {
+            parent_thread_id,
+            agent_path: Some(child),
+            ..
+        },
+    ) = &outcome.source
+    else {
+        return None;
+    };
+    let parent = AgentPath::try_from(child.as_str().rsplit_once('/')?.0).ok()?;
+    let text = match (&outcome.status, &outcome.error_info) {
+        (
+            AgentStatus::Errored(error),
+            Some(codex_protocol::protocol::CodexErrorInfo::TooManyDenials),
+        ) => Some(crate::session_prefix::format_guardian_interruption_message(
+            parent.clone(),
+            child.clone(),
+            error,
+        )),
+        _ => crate::session_prefix::format_inter_agent_completion_message(
+            parent.clone(),
+            child.clone(),
+            &outcome.status,
+        ),
+    }?;
+    Some((
+        *parent_thread_id,
+        InterAgentCommunication::new(child.clone(), parent, Vec::new(), text, false),
+    ))
+}
+
+pub async fn native_agent_snapshot(thread: &CodexThread) -> Result<Value> {
+    let snapshot = crate::agent::control::effective_spawn_config(thread).await?;
+    let source = &snapshot.session_source;
+    let agent = LiveAgent {
+        thread_id: thread.session.thread_id,
+        metadata: AgentMetadata {
+            agent_id: Some(thread.session.thread_id),
+            agent_path: Some(source.get_agent_path().unwrap_or_else(AgentPath::root)),
+            agent_nickname: source.get_nickname(),
+            agent_role: source.get_agent_role(),
+        },
+        status: thread.io.agent_status.borrow().clone(),
+    };
+    Ok(json!({"sessionId":thread.session.session_id(), "agent":agent, "configSnapshot":snapshot}))
+}
+
+/// Called under the transport's per-thread lock, after observers are registered.
+pub async fn native_submit_agent_input(
+    thread: &CodexThread,
+    author: AgentPath,
+    input: NativeAgentInput,
+    start: NativeTurnStartOptions,
+    context_items: Vec<ResponseItem>,
+    expected_turn_id: Option<String>,
+) -> Result<Value> {
+    if let Some(expected) = &expected_turn_id {
+        let active = thread
+            .session
+            .active_turn_context_and_cancellation_token()
+            .await;
+        if active.as_ref().map(|(turn, _)| turn.sub_id.as_str()) != Some(expected.as_str()) {
+            return Err(CodexErr::InvalidRequest(
+                "expected native turn is no longer active".into(),
+            ));
+        }
+    }
+    if !context_items.is_empty() {
+        thread.inject_response_items_for_turn(context_items).await?;
+    }
+    let id = uuid::Uuid::now_v7().to_string();
+    let recipient = thread
+        .session_source
+        .get_agent_path()
+        .unwrap_or_else(AgentPath::root);
+    let turn = match input {
+        NativeAgentInput::UserInput { items } => {
+            let request = TurnInputRequest::user_input(items).on_start(start.into());
+            if let Some(expected) = expected_turn_id {
+                match thread.steer_turn(request, expected).await? {
+                    codex_protocol::turn_input::SteerSubmission::Steered { turn_id } => {
+                        Some(turn_id)
+                    }
+                    codex_protocol::turn_input::SteerSubmission::NotSubmitted { reason } => {
+                        return Err(CodexErr::InvalidRequest(format!(
+                            "native input not steered: {reason:?}"
+                        )));
+                    }
+                }
+            } else {
+                match thread.start_or_steer_turn(request).await? {
+                    TurnInputSubmission::Started { turn_id, .. }
+                    | TurnInputSubmission::Steered { turn_id, .. } => Some(turn_id),
+                    TurnInputSubmission::Accepted => None,
+                    TurnInputSubmission::NotSubmitted { reason } => {
+                        return Err(CodexErr::InvalidRequest(format!(
+                            "native input not submitted: {reason:?}"
+                        )));
+                    }
+                }
+            }
+        }
+        NativeAgentInput::Message { message, mode } => {
+            let communication = message.into_communication(author, recipient, mode);
+            deliver_communication(thread, communication, start.into(), expected_turn_id).await?
+        }
+        NativeAgentInput::Communication { communication } => {
+            if communication.author != author || communication.recipient != recipient {
+                return Err(CodexErr::InvalidRequest(
+                    "native communication attribution mismatch".into(),
+                ));
+            }
+            deliver_communication(thread, communication, start.into(), expected_turn_id).await?
+        }
+    };
+    Ok(
+        json!({"threadId":thread.session.thread_id, "submissionId":id, "accepted":true, "turn":turn.map(|id|json!({"id":id,"status":"inProgress","items":[]}))}),
+    )
+}
+
+async fn deliver_communication(
+    thread: &CodexThread,
+    communication: InterAgentCommunication,
+    start: TurnStartOptions,
+    expected_turn_id: Option<String>,
+) -> Result<Option<String>> {
+    if !communication.trigger_turn && expected_turn_id.is_none() {
+        thread
+            .session
+            .input_queue
+            .enqueue_mailbox_communication(communication.into(), start)
+            .await;
+        return Ok(None);
+    }
+    let mut init = thread.config_snapshot().await.turn_extension_init;
+    init.insert(NativeAgentTransportInput);
+    let request = crate::WithTurnExtensionData::new(
+        TurnInputRequest::new(TurnInput::InterAgentCommunication(communication)).on_start(start),
+        init,
+    );
+    if let Some(expected) = expected_turn_id {
+        match thread.steer_turn(request, expected).await? {
+            codex_protocol::turn_input::SteerSubmission::Steered { turn_id } => Ok(Some(turn_id)),
+            codex_protocol::turn_input::SteerSubmission::NotSubmitted { reason } => Err(
+                CodexErr::InvalidRequest(format!("native message not steered: {reason:?}")),
+            ),
+        }
+    } else {
+        match thread.start_or_steer_turn(request).await? {
+            TurnInputSubmission::Started { turn_id, .. }
+            | TurnInputSubmission::Steered { turn_id, .. } => Ok(Some(turn_id)),
+            TurnInputSubmission::Accepted => Err(CodexErr::InvalidRequest(
+                "native message lost synchronous acceptance".into(),
+            )),
+            TurnInputSubmission::NotSubmitted { reason } => Err(CodexErr::InvalidRequest(format!(
+                "native message not submitted: {reason:?}"
+            ))),
+        }
+    }
+}
