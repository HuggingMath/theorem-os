+#[derive(Clone)]
+struct NativeHostControl {
+    bridge: Weak<NativeAgentBridge>,
+    thread_id: ThreadId,
+    session_id: SessionId,
+    local: Arc<Mutex<LocalState>>,
+}
+
+impl NativeHostControl {
+    async fn rpc(&self, operation: &str, payload: Value) -> Result<Value> {
+        let bridge = self
+            .bridge
+            .upgrade()
+            .ok_or_else(|| CodexErr::InvalidRequest("native host transport is closed".into()))?;
+        let params = TheoremosAgentControlRequestParams {
+            value: json!({"version":1,"sessionId":self.session_id,"threadId":self.thread_id,"operationId":uuid::Uuid::now_v7().to_string(),"operation":operation,"payload":payload}),
+        };
+        let (request_id, receiver) = bridge
+            .outgoing
+            .send_request(ServerRequestPayload::TheoremosAgentControlRequest(params))
+            .await;
+        struct Pending {
+            outgoing: Arc<OutgoingMessageSender>,
+            id: Option<codex_app_server_protocol::RequestId>,
+        }
+        impl Drop for Pending {
+            fn drop(&mut self) {
+                if let Some(id) = self.id.take() {
+                    let outgoing = self.outgoing.clone();
+                    if let Ok(runtime) = tokio::runtime::Handle::try_current() {
+                        runtime.spawn(async move {
+                            outgoing.cancel_request(&id).await;
+                        });
+                    }
+                }
+            }
+        }
+        let mut pending = Pending {
+            outgoing: bridge.outgoing.clone(),
+            id: Some(request_id),
+        };
+        let response = receiver
+            .await
+            .map_err(|_| CodexErr::InvalidRequest("native host callback disconnected".into()))?
+            .map_err(|error| {
+                CodexErr::InvalidRequest(format!("native host {operation}: {}", error.message))
+            })?;
+        pending.id = None;
+        response.get("result").cloned().ok_or_else(|| {
+            CodexErr::InvalidRequest(format!("native host {operation} omitted result"))
+        })
+    }
+    fn spawn_rpc(&self, operation: &'static str, payload: Value) {
+        let control = self.clone();
+        tokio::spawn(async move {
+            if let Err(error) = control.rpc(operation, payload).await {
+                tracing::warn!(%error,operation,"native host background handoff failed");
+            }
+        });
+    }
+    async fn target(&self, target: AgentTarget) -> Result<Value> {
+        match target {
+            AgentTarget::Id(id) => Ok(json!({"kind":"id","threadId":id})),
+            AgentTarget::Reference(reference) => {
+                let bridge = self.bridge.upgrade().ok_or_else(|| {
+                    CodexErr::InvalidRequest("native host transport closed".into())
+                })?;
+                let thread = bridge.manager()?.get_thread(self.thread_id).await?;
+                let base = thread
+                    .session_source()
+                    .get_agent_path()
+                    .unwrap_or_else(AgentPath::root);
+                let path = base
+                    .resolve(&reference)
+                    .map_err(CodexErr::UnsupportedOperation)?;
+                Ok(json!({"kind":"reference","reference":path}))
+            }
+        }
+    }
+}
+
+impl AgentControl for NativeHostControl {
+    fn identity(&self) -> SessionId {
+        self.session_id
+    }
+    fn configure_startup(&self, data: &mut ExtensionDataInit, config: &codex_core::config::Config) {
+        self.local
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .service_tier = config.service_tier.clone();
+        data.insert(AgentRuntimeOwnership::Host);
+        data.insert(Arc::new(self.clone()) as Arc<dyn AgentTurnAdmission>);
+        data.insert(Arc::new(self.clone()) as Arc<dyn AgentUsageAccounting>);
+        data.insert(Arc::new(self.clone()) as Arc<dyn AgentServiceTier>);
+        data.insert(Arc::new(self.clone()) as Arc<dyn AgentSessionReader>);
+        if self.session_id == SessionId::from(self.thread_id) {
+            data.insert(Arc::new(self.clone()) as Arc<dyn AgentTurnOutcomeReporter>);
+        }
+    }
+    fn resolve<'a>(
+        &'a self,
+        caller: ThreadId,
+        parent: Option<ThreadId>,
+        source: &'a SessionSource,
+        target: &'a str,
+    ) -> BoxFuture<'a, Result<ThreadId>> {
+        Box::pin(async move {
+            let target = match ThreadId::from_string(target) {
+                Ok(id) => json!({"kind":"id","threadId":id}),
+                Err(_) => {
+                    json!({"kind":"reference","reference":source.get_agent_path().unwrap_or_else(AgentPath::root).resolve(target).map_err(CodexErr::UnsupportedOperation)?})
+                }
+            };
+            let value = self
+                .rpc(
+                    "resolve",
+                    json!({"caller":caller,"parent":parent,"source":source,"target":target}),
+                )
+                .await?;
+            serde_json::from_value(value.get("threadId").cloned().unwrap_or(Value::Null))
+                .map_err(decode_error)
+        })
+    }
+    fn spawn(
+        &self,
+        request: SpawnRequest,
+    ) -> BoxFuture<'_, Result<(LiveAgent, ThreadConfigSnapshot)>> {
+        Box::pin(async move {
+            let caller = request.caller;
+            let source = request.source.clone();
+            let bridge = self
+                .bridge
+                .upgrade()
+                .ok_or_else(|| CodexErr::InvalidRequest("native host transport closed".into()))?;
+            let parent = bridge.manager()?.get_thread(caller).await?;
+            let (bootstrap, input, start) = codex_core::prepare_native_child_bootstrap(
+                parent.as_ref(),
+                self.session_id,
+                request,
+            )
+            .await?;
+            let value=self.rpc("spawn",json!({"caller":caller,"source":source,"bootstrap":bootstrap,"input":input,"startOptions":start})).await?;
+            Ok((
+                serde_json::from_value(value.get("agent").cloned().unwrap_or(Value::Null))
+                    .map_err(decode_error)?,
+                serde_json::from_value(value.get("configSnapshot").cloned().unwrap_or(Value::Null))
+                    .map_err(decode_error)?,
+            ))
+        })
+    }
+    fn send(&self, request: SendRequest) -> BoxFuture<'_, Result<DeliveryReceipt>> {
+        Box::pin(async move {
+            let target = self.target(request.target).await?;
+            let value=self.rpc("send",json!({"caller":request.caller,"target":target,"input":codex_core::native_agent_input_value(request.input),"startOptions":NativeTurnStartOptions::from(request.start_options)})).await?;
+            #[derive(Deserialize)]
+            #[serde(rename_all = "camelCase")]
+            struct Receipt {
+                thread_id: ThreadId,
+                metadata: AgentMetadata,
+                submission_id: String,
+            }
+            let receipt: Receipt = serde_json::from_value(value).map_err(decode_error)?;
+            Ok(DeliveryReceipt {
+                thread_id: receipt.thread_id,
+                metadata: receipt.metadata,
+                submission_id: receipt.submission_id,
+            })
+        })
+    }
+    fn take_mailbox(&self, _agent: ThreadId) -> Vec<PendingAgentMessage> {
+        let mut local = self.local.lock().unwrap_or_else(PoisonError::into_inner);
+        let messages = std::mem::take(&mut local.mailbox);
+        local.watch.send_replace(false);
+        messages
+    }
+    fn watch_mailbox(&self, _agent: ThreadId) -> watch::Receiver<bool> {
+        self.local
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .watch
+            .subscribe()
+    }
+    fn ensure_child_loaded(&self, parent: ThreadId, child: ThreadId) -> BoxFuture<'_, Result<()>> {
+        Box::pin(async move {
+            self.rpc("ensureChildLoaded", json!({"parent":parent,"child":child}))
+                .await?;
+            Ok(())
+        })
+    }
+    fn interrupt(
+        &self,
+        caller: ThreadId,
+        target: AgentTarget,
+        version: MultiAgentVersion,
+    ) -> BoxFuture<'_, Result<AgentInfo>> {
+        Box::pin(async move {
+            let value = self
+                .rpc(
+                    "interrupt",
+                    json!({"caller":caller,"target":self.target(target).await?,"version":version}),
+                )
+                .await?;
+            match value.get("kind").and_then(Value::as_str) {
+                Some("loaded") => Ok(AgentInfo::Loaded {
+                    agent: serde_json::from_value(value["agent"].clone()).map_err(decode_error)?,
+                    config: Box::new(
+                        serde_json::from_value(value["configSnapshot"].clone())
+                            .map_err(decode_error)?,
+                    ),
+                }),
+                Some("unloaded") => Ok(AgentInfo::Unloaded(
+                    serde_json::from_value(value["metadata"].clone()).map_err(decode_error)?,
+                )),
+                _ => Err(CodexErr::InvalidRequest(
+                    "host interrupt returned invalid observation".into(),
+                )),
+            }
+        })
+    }
+    fn list<'a>(
+        &'a self,
+        caller: ThreadId,
+        parent: Option<ThreadId>,
+        source: &'a SessionSource,
+        path_prefix: Option<&'a str>,
+    ) -> BoxFuture<'a, Result<Vec<LiveAgent>>> {
+        Box::pin(async move {
+            let path = path_prefix
+                .map(|prefix| {
+                    source
+                        .get_agent_path()
+                        .unwrap_or_else(AgentPath::root)
+                        .resolve(prefix)
+                        .map_err(CodexErr::UnsupportedOperation)
+                })
+                .transpose()?;
+            let value = self
+                .rpc(
+                    "list",
+                    json!({"caller":caller,"parent":parent,"source":source,"pathPrefix":path}),
+                )
+                .await?;
+            serde_json::from_value(value["agents"].clone()).map_err(decode_error)
+        })
+    }
+    fn child_agent_paths(&self, parent: ThreadId) -> BoxFuture<'_, Vec<AgentPath>> {
+        Box::pin(async move {
+            match self
+                .rpc("childPaths", json!({"parent":parent}))
+                .await
+                .and_then(|v| serde_json::from_value(v["paths"].clone()).map_err(decode_error))
+            {
+                Ok(paths) => paths,
+                Err(error) => {
+                    tracing::warn!(%error,"native host roster unavailable");
+                    Vec::new()
+                }
+            }
+        })
+    }
+    fn check_turn_admission(
+        &self,
+        _version: MultiAgentVersion,
+        _source: &SessionSource,
+    ) -> Result<()> {
+        let state = self.local.lock().unwrap_or_else(PoisonError::into_inner);
+        if state.allowed {
+            Ok(())
+        } else {
+            Err(CodexErr::InvalidRequest(
+                state
+                    .denial
+                    .clone()
+                    .unwrap_or_else(|| "native host admission denied".into()),
+            ))
+        }
+    }
+    fn admit_turn(
+        &self,
+        _version: MultiAgentVersion,
+        _source: &SessionSource,
+    ) -> Option<AgentExecutionGuard> {
+        None
+    }
+    fn record_usage(&self, usage: TokenUsage) -> BoxFuture<'_, Result<()>> {
+        Box::pin(async move {
+            self.rpc(
+                "recordUsage",
+                json!({"usage":usage,"codexRolloutBudgetUnits":usage.codex_rollout_budget_units}),
+            )
+            .await?;
+            Ok(())
+        })
+    }
+    fn turn_finished<'a>(
+        &'a self,
+        outcome: AgentTurnOutcome,
+        _trace: &'a ThreadTraceContext,
+    ) -> BoxFuture<'a, ()> {
+        Box::pin(async move {
+            let completion = codex_core::native_completion_communication(&outcome);
+            let payload = json!({"outcome":{"threadId":outcome.thread_id,"turnId":outcome.turn_id,"source":outcome.source,"parentTurnId":outcome.parent_turn_id,"initiatingAgentPath":outcome.initiating_agent_path,"status":outcome.status,"errorInfo":outcome.error_info},"parentThreadId":completion.as_ref().map(|(id,_)|id),"completionMessage":completion.map(|(_,communication)|communication)});
+            if let Err(error) = self.rpc("turnFinished", payload).await {
+                tracing::warn!(%error,"native host completion handoff failed");
+            }
+        })
+    }
+    fn service_tier(&self) -> Option<String> {
+        self.local
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .service_tier
+            .clone()
+    }
+    fn propagate_config_update(&self, update: AgentConfigUpdate) {
+        let AgentConfigUpdate::ServiceTier(tier) = update;
+        self.local
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .service_tier = tier.clone();
+        self.spawn_rpc("configUpdate", json!({"serviceTier":tier}));
+    }
+    fn get_guardian_package(
+        &self,
+        _agent: ThreadId,
+    ) -> BoxFuture<'_, Option<codex_core::GuardianRootSnapshot>> {
+        Box::pin(async { None })
+    }
+    fn pending_budget_reminder<'a>(
+        &'a self,
+        _agent: ThreadId,
+        _window: &'a str,
+    ) -> BoxFuture<'a, Option<RolloutBudgetReminder>> {
+        Box::pin(async { None })
+    }
+    fn mark_budget_reminder_delivered<'a>(
+        &'a self,
+        _agent: ThreadId,
+        _window: &'a str,
+        _reminder: RolloutBudgetReminder,
+    ) -> BoxFuture<'a, ()> {
+        Box::pin(async {})
+    }
+}
+
+impl AgentTurnAdmission for NativeHostControl {
+    fn admit_turn(
+        &self,
+        request: AgentTurnAdmissionRequest,
+    ) -> BoxFuture<'_, Result<AgentExecutionGuard>> {
+        Box::pin(async move {
+            let payload = json!({"threadId":request.thread_id,"turnId":request.turn_id});
+            let result = self.rpc("admitTurn", payload.clone()).await?;
+            if result.get("admitted") != Some(&Value::Bool(true)) {
+                return Err(CodexErr::new(
+                    codex_protocol::error::CodexErrorDetails::AgentLimitReached { max_threads: 0 },
+                ));
+            }
+            struct Permit {
+                control: NativeHostControl,
+                payload: Value,
+            }
+            impl Drop for Permit {
+                fn drop(&mut self) {
+                    self.control.spawn_rpc("releaseTurn", self.payload.clone());
+                }
+            }
+            Ok(AgentExecutionGuard::new(Permit {
+                control: self.clone(),
+                payload,
+            }))
+        })
+    }
+}
