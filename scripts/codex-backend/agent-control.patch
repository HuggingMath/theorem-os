+            self.rpc("recordUsage",json!({"threadId":report.thread_id,"turnId":report.turn_id,"usage":report.usage,"codexRolloutBudgetUnits":report.usage.codex_rollout_budget_units})).await?;
+            Ok(UsageAccountingDecision::Continue)
