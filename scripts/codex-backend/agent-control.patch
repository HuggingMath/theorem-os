+#[tokio::test]
+async fn native_message_steer_preserves_author_and_requires_matching_active_turn() {
+    use crate::agent::host::wire::NativeAgentTransportInput;
+    use crate::agent::types::{AgentMessage, MessageDeliveryMode};
+    use codex_extension_api::ExtensionDataInit;
+
+    let (session, turn_context, _events) = make_session_and_context_with_rx().await;
+    session
+        .spawn_task(
+            Arc::clone(&turn_context),
+            Vec::new(),
+            NeverEndingTask {
+                kind: TaskKind::Regular,
+                listen_to_cancellation_token: true,
+            },
+        )
+        .await;
+    let communication = AgentMessage::Encrypted("amended objective".into()).into_communication(
+        AgentPath::try_from("/root/expert").unwrap(),
+        AgentPath::root(),
+        MessageDeliveryMode::TriggerTurn,
+    );
+    let request = || {
+        let mut init = ExtensionDataInit::default();
+        init.insert(NativeAgentTransportInput);
+        WithTurnExtensionData::new(
+            TurnInputRequest::new(SubmittedTurnInput::InterAgentCommunication(
+                communication.clone(),
+            )),
+            init,
+        )
+    };
+    let ordinary = handle(
+        &session,
+        TurnInputRequest::new(SubmittedTurnInput::InterAgentCommunication(
+            communication.clone(),
+        )),
+        TurnInputMode::Steer {
+            expected_turn_id: turn_context.sub_id.clone(),
+        },
+        "untrusted-message".into(),
+    )
+    .await
+    .expect_err("ordinary message steering remains unsupported");
+    assert!(
+        ordinary
+            .to_string()
+            .contains("only user input can steer a turn")
+    );
+    let mismatch = handle(
+        &session,
+        request(),
+        TurnInputMode::Steer {
+            expected_turn_id: "wrong-turn".into(),
+        },
+        "native-mismatch".into(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(
+        mismatch,
+        TurnInputSubmission::NotSubmitted {
+            reason: NotSubmittedReason::ExpectedTurnMismatch {
+                expected: "wrong-turn".into(),
+                actual: turn_context.sub_id.clone(),
+            },
+        }
+    );
+    assert!(
+        session
+            .input_queue
+            .get_pending_input(&session.active_turn)
+            .await
+            .0
+            .is_empty()
+    );
+    let accepted = handle(
+        &session,
+        request(),
+        TurnInputMode::Steer {
+            expected_turn_id: turn_context.sub_id.clone(),
+        },
+        "native-notice".into(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(
+        accepted,
+        TurnInputSubmission::Steered {
+            turn_id: turn_context.sub_id.clone(),
+            root_turn_id: turn_context.root_turn_id(),
+        }
+    );
+    assert_eq!(
+        session
+            .input_queue
+            .get_pending_input(&session.active_turn)
+            .await
+            .0,
+        vec![TurnInput::InterAgentCommunication(
+            communication.clone().into()
+        )],
+    );
+    session.abort_all_tasks(TurnAbortReason::Interrupted).await;
+    let idle = handle(
+        &session,
+        request(),
+        TurnInputMode::Steer {
+            expected_turn_id: turn_context.sub_id.clone(),
+        },
+        "native-idle-notice".into(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(
+        idle,
+        TurnInputSubmission::NotSubmitted {
+            reason: NotSubmittedReason::NoActiveTurn
+        }
+    );
+    assert!(session.active_turn.lock().await.is_none());
+}
