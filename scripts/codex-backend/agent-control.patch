@@ -0,0 +1,73 @@
+//! Opt-in trusted host transport for an external AgentControl execution backend.
+//!
+//! These envelopes are decoded and validated by the opted-in backend. They are
+//! not dynamic model tools, and do not grant mathematical acceptance.
+
+use crate::JsonSchema;
+use crate::TS;
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::Value;
+
+macro_rules! host_envelope {
+    ($($name:ident),+ $(,)?) => {$(
+        #[derive(Serialize, Deserialize, Debug, Clone, Default, PartialEq, JsonSchema, TS)]
+        #[serde(transparent)]
+        #[ts(type = "unknown", export_to = "v2/")]
+        pub struct $name {
+            pub value: Value,
+        }
+    )+};
+}
+
+host_envelope!(
+    TheoremosAgentControlCapabilitiesParams,
+    TheoremosAgentControlCapabilitiesResponse,
+    TheoremosAgentControlStartParams,
+    TheoremosAgentControlStartResponse,
+    TheoremosAgentControlInputParams,
+    TheoremosAgentControlInputResponse,
+    TheoremosAgentControlUpdateParams,
+    TheoremosAgentControlUpdateResponse,
+    TheoremosAgentControlSnapshotParams,
+    TheoremosAgentControlSnapshotResponse,
+    TheoremosAgentControlRequestParams,
+    TheoremosAgentControlRequestResponse,
+);
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::ClientRequest;
+    use crate::RequestId;
+    use crate::ServerRequest;
+    use crate::ServerResponse;
+    use serde_json::json;
+
+    #[test]
+    fn native_host_requests_preserve_the_trusted_wire_envelope() {
+        let value = json!({"version":1,"threadId":"child","bootstrap":{"sessionId":"root"},
+            "thread":{"cwd":"/isolated/worker"}});
+        let request = ClientRequest::TheoremosAgentControlStart {
+            request_id: RequestId::Integer(7),
+            params: TheoremosAgentControlStartParams { value: value.clone() },
+        };
+        assert_eq!(serde_json::to_value(request).unwrap(), json!({"id":7,
+            "method":"theoremos/agentControl/start","params":value}));
+    }
+
+    #[test]
+    fn native_backend_callbacks_decode_host_results_without_tool_wrappers() {
+        let request = ServerRequest::TheoremosAgentControlRequest {
+            request_id: RequestId::Integer(8),
+            params: TheoremosAgentControlRequestParams { value: json!({"version":1,
+                "sessionId":"root","threadId":"root","operationId":"stable-id",
+                "operation":"spawn","payload":{}}) },
+        };
+        let response = request.response_from_result(json!({"result":{"submissionId":"turn"}})).unwrap();
+        let ServerResponse::TheoremosAgentControlRequest { response, .. } = response else {
+            panic!("wrong callback response");
+        };
+        assert_eq!(response.value, json!({"result":{"submissionId":"turn"}}));
+    }
+}
