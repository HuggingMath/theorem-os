+}
+impl AgentServiceTier for NativeHostControl {
+    fn current(&self) -> BoxFuture<'_, Option<String>> {
+        Box::pin(async move { AgentControl::service_tier(self) })
+    }
+    fn update(&self, tier: Option<String>) -> BoxFuture<'static, std::result::Result<(), String>> {
+        let control = self.clone();
+        self.local
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .service_tier = tier.clone();
+        let task = tokio::spawn(async move {
+            control
+                .rpc("configUpdate", json!({"serviceTier":tier}))
+                .await
+                .map(|_| ())
+                .map_err(|error| error.to_string())
+        });
+        Box::pin(async move { task.await.map_err(|error| error.to_string())? })
+    }
+}
