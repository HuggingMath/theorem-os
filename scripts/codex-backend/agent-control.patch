+    #[test]
+    fn trusted_relocation_preserves_secret_denies_and_revokes_source_write() {
+        let workspace = tempfile::tempdir().unwrap();
+        let from = AbsolutePathBuf::from_absolute_path(workspace.path().join("lead")).unwrap();
+        let agents = AbsolutePathBuf::from_absolute_path(workspace.path().join("agents")).unwrap();
+        let to = AbsolutePathBuf::from_absolute_path(agents.join("algebra")).unwrap();
+        let peer = AbsolutePathBuf::from_absolute_path(agents.join("topology")).unwrap();
+        let secret = AbsolutePathBuf::from_absolute_path(workspace.path().join("secrets")).unwrap();
+        for directory in [&from, &to, &peer, &secret] {
+            std::fs::create_dir_all(directory).unwrap();
+        }
+        let local_entry = |path: &AbsolutePathBuf, access| {
+            FileSystemSandboxEntry::new(
+                FileSystemPath::Path {
+                    path: PathUri::from_abs_path(path),
+                },
+                access,
+            )
+        };
+        let parent = PermissionProfile::from_runtime_permissions(
+            &FileSystemSandboxPolicy::restricted(vec![
+                entry("/", FileSystemAccessMode::Read),
+                local_entry(&from, FileSystemAccessMode::Write),
+                local_entry(&agents, FileSystemAccessMode::Deny),
+                local_entry(&secret, FileSystemAccessMode::Deny),
+            ]),
+            NetworkSandboxPolicy::Restricted,
+        );
+        let relocated = relocate_workspace_authority(&parent, &from, &to).unwrap();
+        let fs = relocated.file_system_sandbox_policy();
+        assert!(fs.can_write_local_path_with_cwd(to.as_path(), to.as_path()));
+        assert!(!fs.can_write_local_path_with_cwd(from.as_path(), to.as_path()));
+        assert!(
+            fs.entries
+                .contains(&local_entry(&secret, FileSystemAccessMode::Deny))
+        );
+        assert_eq!(
+            relocated.network_sandbox_policy(),
+            NetworkSandboxPolicy::Restricted
+        );
+        let destination = PermissionProfile::from_runtime_permissions(
+            &FileSystemSandboxPolicy::restricted(vec![
+                entry("/", FileSystemAccessMode::Read),
+                local_entry(&to, FileSystemAccessMode::Write),
+                local_entry(&from, FileSystemAccessMode::Deny),
+                local_entry(&peer, FileSystemAccessMode::Deny),
+            ]),
+            NetworkSandboxPolicy::Enabled,
+        );
+        let bounded =
+            intersect_effective_permission_profiles(&relocated, &destination, to.as_path())
+                .unwrap();
+        assert!(
+            bounded
+                .file_system_sandbox_policy()
+                .can_write_local_path_with_cwd(to.as_path(), to.as_path())
+        );
+        assert!(
+            !bounded
+                .file_system_sandbox_policy()
+                .can_write_local_path_with_cwd(from.as_path(), to.as_path())
+        );
+        assert!(
+            !bounded
+                .file_system_sandbox_policy()
+                .can_read_local_path_with_cwd(peer.as_path(), to.as_path())
+        );
+        assert_eq!(
+            bounded.network_sandbox_policy(),
+            NetworkSandboxPolicy::Restricted
+        );
+    }
