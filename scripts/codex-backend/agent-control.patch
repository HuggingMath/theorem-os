+        })
+    }
+}
+impl AgentSessionReader for NativeHostControl {
+    fn root(&self) -> BoxFuture<'_, Result<AgentRef>> {
+        Box::pin(async move {
+            Ok(AgentRef {
+                thread_id: self.session_id.into(),
+                path: AgentPath::root(),
+            })
+        })
+    }
+    fn parent(&self) -> BoxFuture<'_, Result<Option<AgentRef>>> {
+        Box::pin(async move {
+            let bridge = self
+                .bridge
+                .upgrade()
+                .ok_or_else(|| CodexErr::InvalidRequest("native host transport closed".into()))?;
+            let thread = bridge.manager()?.get_thread(self.thread_id).await?;
+            let Some(parent) = thread.session_source().parent_thread_id() else {
+                return Ok(None);
+            };
+            let path = thread
+                .session_source()
+                .get_agent_path()
+                .and_then(|path| {
+                    path.as_str()
+                        .rsplit_once('/')
+                        .and_then(|(parent, _)| AgentPath::try_from(parent).ok())
+                })
+                .ok_or_else(|| {
+                    CodexErr::InvalidRequest("native child parent path missing".into())
+                })?;
+            Ok(Some(AgentRef {
+                thread_id: parent,
+                path,
+            }))
+        })
+    }
+    fn children(&self) -> BoxFuture<'_, Result<Vec<AgentRef>>> {
+        Box::pin(async move {
+            let value = self
+                .rpc("childPaths", json!({"parent":self.thread_id}))
+                .await?;
+            let paths: Vec<AgentPath> =
+                serde_json::from_value(value["paths"].clone()).map_err(decode_error)?;
+            let mut children = Vec::with_capacity(paths.len());
+            for path in paths {
+                let response=self.rpc("resolve",json!({"caller":self.thread_id,"parent":Value::Null,"source":SessionSource::Cli,"target":{"kind":"reference","reference":path}})).await?;
+                let thread_id: ThreadId =
+                    serde_json::from_value(response["threadId"].clone()).map_err(decode_error)?;
+                children.push(AgentRef { thread_id, path });
+            }
+            Ok(children)
+        })
+    }
+}
+
+fn decode_error(error: serde_json::Error) -> CodexErr {
+    CodexErr::InvalidRequest(format!("invalid native host response: {error}"))
+}
+fn rpc_error(error: CodexErr) -> JSONRPCErrorError {
+    internal_error(error.to_string())
+}
