+#[tokio::test]
+async fn native_trigger_samples_queued_mail_before_its_first_response() {
+    use crate::agent::host::wire::NativeAgentTransportInput;
+    use crate::agent::types::{AgentMessage, MessageDeliveryMode};
+    use crate::session::tests::make_session_and_context_with_auth_and_config_and_rx;
+    use codex_extension_api::ExtensionDataInit;
+    use core_test_support::responses;
+
+    let server = responses::start_mock_server().await;
+    let requests = responses::mount_sse_once(
+        &server,
+        responses::sse(vec![
+            responses::ev_response_created("native-mailbox"),
+            responses::ev_completed("native-mailbox"),
+        ]),
+    )
+    .await;
+    let mut provider = codex_model_provider_info::built_in_model_providers(None)["openai"].clone();
+    provider.base_url = Some(format!("{}/v1", server.uri()));
+    provider.supports_websockets = false;
+    let (session, _turn_context, events) = make_session_and_context_with_auth_and_config_and_rx(
+        codex_login::CodexAuth::from_api_key("offline-native-mailbox"),
+        Vec::new(),
+        move |config| {
+            config.model = Some("gpt-5.2".into());
+            config.model_provider = provider;
+            config.features.enable(Feature::MultiAgentV2).unwrap();
+            config.features.disable(Feature::TokenBudget).unwrap();
+        },
+    )
+    .await;
+    let message = |text: &str, mode| {
+        AgentMessage::Encrypted(text.into()).into_communication(
+            AgentPath::root(),
+            AgentPath::root(),
+            mode,
+        )
+    };
+    session
+        .input_queue
+        .enqueue_mailbox_communication(
+            message("queued-before-trigger", MessageDeliveryMode::QueueOnly).into(),
+            Default::default(),
+        )
+        .await;
+    let mut init = ExtensionDataInit::default();
+    init.insert(NativeAgentTransportInput);
+    let submission = handle(
+        &session,
+        WithTurnExtensionData::new(
+            TurnInputRequest::new(SubmittedTurnInput::InterAgentCommunication(message(
+                "current-native-trigger",
+                MessageDeliveryMode::TriggerTurn,
+            ))),
+            init,
+        ),
+        TurnInputMode::StartOrSteer,
+        "native-mailbox-turn".into(),
+    )
+    .await
+    .expect("native trigger accepted");
+    assert!(matches!(submission, TurnInputSubmission::Started { .. }));
+    tokio::time::timeout(std::time::Duration::from_secs(10), async {
+        loop {
+            let event = events.recv().await.expect("turn events open");
+            if matches!(event.msg, EventMsg::TurnComplete(_)) {
+                break;
+            }
+        }
+    })
+    .await
+    .expect("loopback native turn completed");
+    let input = serde_json::to_string(&requests.single_request().input()).unwrap();
+    let queued = input
+        .find("queued-before-trigger")
+        .expect("queued mail in first request");
+    let trigger = input
+        .find("current-native-trigger")
+        .expect("trigger in first request");
+    assert!(
+        queued < trigger,
+        "accepted native mailbox order must be preserved"
+    );
+    assert!(!session.input_queue.has_pending_mailbox_items().await);
+}
