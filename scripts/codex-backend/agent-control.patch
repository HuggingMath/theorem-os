+//! Opt-in stdio transport for the native AgentControl execution contract.
+//! The model still invokes upstream collaboration handlers. The trusted host owns
+//! isolated runtimes and durable membership; it is never a dynamic-tool facade.
+
+use crate::error_code::{internal_error, invalid_params, invalid_request};
