+/// Complete trusted transport snapshot. Unknown executable rule implementations fail export.
+#[derive(Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct PolicySnapshot {
+    prefix_rules: Vec<PrefixRule>,
+    network_rules: Vec<NetworkRule>,
+    host_executables: HashMap<String, Arc<[AbsolutePathBuf]>>,
+}
+
+impl Serialize for Policy {
+    fn serialize<S: serde::Serializer>(
+        &self,
+        serializer: S,
+    ) -> std::result::Result<S::Ok, S::Error> {
+        let prefix_rules = self
+            .rules_by_program
+            .iter_all()
+            .flat_map(|(_, rules)| rules)
+            .map(|rule| {
+                rule.as_any()
+                    .downcast_ref::<PrefixRule>()
+                    .cloned()
+                    .ok_or_else(|| {
+                        <S::Error as serde::ser::Error>::custom(
+                            "unsupported transported exec-policy rule",
+                        )
+                    })
+            })
+            .collect::<std::result::Result<Vec<_>, _>>()?;
+        PolicySnapshot {
+            prefix_rules,
+            network_rules: self.network_rules.clone(),
+            host_executables: self.host_executables_by_name.clone(),
+        }
+        .serialize(serializer)
+    }
+}
+
+impl<'de> Deserialize<'de> for Policy {
+    fn deserialize<D: serde::Deserializer<'de>>(
+        deserializer: D,
+    ) -> std::result::Result<Self, D::Error> {
+        let snapshot = PolicySnapshot::deserialize(deserializer)?;
+        let mut rules = MultiMap::new();
+        for rule in snapshot.prefix_rules {
+            rules.insert(rule.pattern.first.to_string(), Arc::new(rule) as RuleRef);
+        }
+        Ok(Self::from_parts(
+            rules,
+            snapshot.network_rules,
+            snapshot.host_executables,
+        ))
+    }
+}
