+    pub user_instructions: Option<NativeInstructions>,
+    pub thread_instructions: Option<NativeInstructions>,
+    pub exec_policy: Policy,
+    pub exec_policy_source_requirements: Option<RequirementsExecPolicy>,
+    pub environments: Vec<TurnEnvironmentRequest>,
+    pub dynamic_tools: Vec<DynamicToolSpec>,
