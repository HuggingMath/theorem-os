+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn control() -> NativeHostControl {
+        let thread_id = ThreadId::from_string("01900000-0000-7000-8000-000000000001").unwrap();
+        NativeHostControl {
+            bridge: Weak::new(),
+            thread_id,
+            session_id: thread_id.into(),
+            local: Arc::new(Mutex::new(LocalState::default())),
+        }
+    }
+    #[test]
+    fn synchronous_mailbox_transfer_clears_watch_without_losing_subscription() {
+        let control = control();
+        let receiver = control.watch_mailbox(control.thread_id);
+        let communication = InterAgentCommunication::new(
+            AgentPath::root(),
+            AgentPath::root(),
+            Vec::new(),
+            "queued".into(),
+            false,
+        );
+        {
+            let mut local = control.local.lock().unwrap();
+            local.mailbox.push(communication.into());
+            local.watch.send_replace(true);
+        }
+        assert!(*receiver.borrow());
+        let messages = control.take_mailbox(control.thread_id);
+        assert_eq!(messages.len(), 1);
+        assert_eq!(messages[0].content, "queued");
+        assert!(!*receiver.borrow());
+        assert!(control.take_mailbox(control.thread_id).is_empty());
+        // A later handoff reuses the same watch subscription.
+        control.local.lock().unwrap().watch.send_replace(true);
+        assert!(*receiver.borrow());
+    }
+    #[tokio::test]
+    async fn native_admission_failure_does_not_fall_back_to_local_capacity() {
+        let control = control();
+        control.local.lock().unwrap().allowed = false;
+        assert!(
+            control
+                .check_turn_admission(MultiAgentVersion::V2, &SessionSource::Cli)
+                .is_err()
+        );
+        let request = AgentTurnAdmissionRequest {
+            thread_id: control.thread_id,
+            turn_id: "actual-turn".into(),
+        };
+        assert!(
+            AgentTurnAdmission::admit_turn(&control, request)
+                .await
+                .is_err()
+        );
+    }
+}
